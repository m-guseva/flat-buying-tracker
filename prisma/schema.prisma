// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Temporary placeholder model to enable Prisma client generation.
// Required because prisma@5.16.0 cannot generate without at least one model.
// This model and schema structure will be replaced with the real domain models in Task 2.
model Placeholder {
  id Int @id @default(autoincrement())
}
